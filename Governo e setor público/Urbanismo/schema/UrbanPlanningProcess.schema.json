{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$schemaVersion": "0.2.1",
  "modelTags": "CNMD",
  "$id": "https://example.org/schemas/UrbanPlanningProcess.schema.json",
  "title": "CNMD - UrbanPlanningProcess schema",
  "description": "Schema for an urban planning and licensing process.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/GSMA-Commons"
    },
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/Location-Commons"
    },
    {
      "properties": {
        "address": {
          "type": "object",
          "properties": {
            "addressLocality": {
              "type": "string",
              "minLength": 1,
              "description": "The locality, which must correspond to the municipality"
            },
            "addressRegion": {
              "type": "string",
              "enum": [
                "Norte",
                "Centro",
                "Oeste e Vale do Tejo",
                "Grande Lisboa",
                "Península de Setúbal",
                "Alentejo",
                "Algarve",
                "Região Autónoma dos Açores",
                "Região Autónoma da Madeira"
              ],
              "description": "The NUTS 2 region in which the locality is located"
            },
            "addressSubRegion": {
              "type": "string",
              "enum": [
                "Alto Minho",
                "Cávado",
                "Ave",
                "Área Metropolitana do Porto",
                "Alto Tâmega e Barroso",
                "Tâmega e Sousa",
                "Douro",
                "Terras de Trás-os-Montes",
                "Região de Aveiro",
                "Região de Coimbra",
                "Região de Leiria",
                "Viseu Dão Lafões",
                "Beira Baixa",
                "Beiras e Serra da Estrela",
                "Oeste",
                "Médio Tejo",
                "Lezíria do Tejo",
                "Grande Lisboa",
                "Península de Setúbal",
                "Alentejo Litoral",
                "Baixo Alentejo",
                "Alto Alentejo",
                "Alentejo Central",
                "Algarve",
                "Região Autónoma dos Açores",
                "Região Autónoma da Madeira"
              ],
              "description": "Property. NUTS 3 sub region in which the locality is located."
            },
            "district": {
              "type": "string",
              "enum": [
                "Açores",
                "Aveiro",
                "Beja",
                "Braga",
                "Bragança",
                "Castelo Branco",
                "Coimbra",
                "Évora",
                "Faro",
                "Guarda",
                "Madeira",
                "Leiria",
                "Lisboa",
                "Portalegre",
                "Porto",
                "Santarém",
                "Setúbal",
                "Viana do Castelo",
                "Vila Real",
                "Viseu"
              ],
              "description": "The administrative district in which the locality is located"
            }
          },
          "required": [
            "addressLocality",
            "addressRegion",
            "addressSubRegion",
            "district"
          ]
        },
        "type": {
          "type": "string",
          "const": "UrbanPlanningProcess",
          "description": "Property. NGSI entity type. It must be UrbanPlanningProcess."
        },
        "dateCreated": {
          "type": "string",
          "format": "date-time",
          "description": "Property. Date and time when the entity was created, in ISO 8601 format."
        },
        "dateModified": {
          "type": "string",
          "format": "date-time",
          "description": "Property. Date and time when the entity was last modified, in ISO 8601 format."
        },
        "interventionType": {
          "type": "string",
          "enum": [
            "construção",
            "reconstrução",
            "ampliação",
            "alteração_exterior",
            "alteração_interior",
            "conservação",
            "construção_piscina"
          ],
          "description": "Property. Type of intervention for which licensing is requested."
        },
        "lastDecisionAt": {
          "type": "string",
          "format": "date-time",
          "description": "Property. Date and time of the latest decision on the process, in ISO 8601 format."
        },
        "licenseNumber": {
          "type": "string",
          "description": "Property. Construction or works permit number."
        },
        "phase": {
          "type": "string",
          "enum": [
            "submissão",
            "saneamento_liminar",
            "decisão",
            "decisão_arquitetura",
            "decisão_especialidades",
            "decisão_controlo_sucessivo",
            "pagamento_de_taxas_e_encargos",
            "obra_diligências_seguintes",
            "conclusão"
          ],
          "description": "Property. Current phase of the urban planning process."
        },
        "proceedingDecision": {
          "type": "string",
          "enum": [
            "aprovação",
            "aprovação_tácita",
            "deferimento",
            "deferimento_tácito",
            "informação_favorável",
            "informação_desfavorável",
            "indeferimento",
            "rejeição",
            "ineptidão",
            "rejeição_liminar",
            "extinção",
            "caducidade",
            "determinação_vistoria",
            "aperfeiçoamento"
          ],
          "description": "Property. Current decision on the urban planning process."
        },
        "processNumber": {
          "type": "string",
          "description": "Property. Identifier of the urban planning process."
        },
        "procedureType": {
          "type": "string",
          "enum": [
            "licenciamento",
            "comunicação_prévia",
            "comunicação_prévia_utilização",
            "comunicação_prévia_com_prazo",
            "pedido_de_informação_prévia",
            "comunicação_de_início_de_trabalhos",
            "outros_procedimentos"
          ],
          "description": "Property. Type of licensing procedure."
        },
        "serviceCode": {
          "type": "string",
          "description": "Property. CUSP code."
        },
        "responsibleEntityCode": {
          "type": "string",
          "description": "Property. Identifier of the entity in CUSP."
        },
        "status": {
          "type": "string",
          "enum": [
            "aguarda_pagamento",
            "em_análise",
            "aguarda_elementos",
            "decidido_favorável",
            "decidido_desfavorável",
            "consultas_externas",
            "aguarda_audiência_dos_interessados",
            "aguarda_pedido_seguinte",
            "arquivado",
            "suspenso",
            "aguarda_vistoria",
            "aguarda_início_dos_trabalhos"
          ],
          "description": "Property. Current status of the urban planning process."
        },
        "refBuilding": {
          "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/EntityIdentifierType",
          "description": "Relationship. URN of the BuildingRegistration entity concerned by the process."
        },
        "refFraction": {
          "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/EntityIdentifierType",
          "description": "Relationship. URN of the UnitRegistration entity concerned by the process; omitted for a whole-building process."
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Property. Date and time when the process was submitted, in ISO 8601 format."
        },
        "urbanOperationType": {
          "type": "string",
          "enum": [
            "construção",
            "reconstrução",
            "ampliação",
            "alteração_exterior",
            "alteração_interior",
            "conservação",
            "construção_piscina"
          ],
          "description": "Property. Type of urban planning operation."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "procedureType": {
                "const": "licenciamento"
              }
            },
            "required": [
              "procedureType"
            ]
          },
          "then": {
            "properties": {
              "proceedingDecision": {
                "enum": [
                  "aprovação",
                  "aprovação_tácita",
                  "deferimento",
                  "deferimento_tácito",
                  "indeferimento",
                  "rejeição_liminar",
                  "extinção",
                  "caducidade",
                  "aperfeiçoamento"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "procedureType": {
                "const": "comunicação_prévia"
              }
            },
            "required": [
              "procedureType"
            ]
          },
          "then": {
            "properties": {
              "proceedingDecision": {
                "enum": [
                  "ineptidão",
                  "extinção",
                  "caducidade"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "procedureType": {
                "const": "comunicação_prévia_utilização"
              }
            },
            "required": [
              "procedureType"
            ]
          },
          "then": {
            "properties": {
              "proceedingDecision": {
                "enum": [
                  "ineptidão",
                  "extinção"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "procedureType": {
                "const": "comunicação_prévia_com_prazo"
              }
            },
            "required": [
              "procedureType"
            ]
          },
          "then": {
            "properties": {
              "proceedingDecision": {
                "enum": [
                  "rejeição",
                  "ineptidão",
                  "extinção",
                  "determinação_vistoria"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "procedureType": {
                "const": "pedido_de_informação_prévia"
              }
            },
            "required": [
              "procedureType"
            ]
          },
          "then": {
            "properties": {
              "proceedingDecision": {
                "enum": [
                  "deferimento_tácito",
                  "informação_favorável",
                  "informação_desfavorável",
                  "rejeição_liminar",
                  "extinção",
                  "caducidade",
                  "aperfeiçoamento"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "procedureType": {
                "const": "comunicação_de_início_de_trabalhos"
              }
            },
            "required": [
              "procedureType"
            ]
          },
          "then": {
            "properties": {
              "proceedingDecision": {
                "enum": [
                  "extinção",
                  "caducidade"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "procedureType": {
                "const": "outros_procedimentos"
              }
            },
            "required": [
              "procedureType"
            ]
          },
          "then": {
            "properties": {
              "proceedingDecision": {
                "enum": [
                  "deferimento",
                  "deferimento_tácito",
                  "indeferimento",
                  "extinção",
                  "determinação_vistoria"
                ]
              }
            }
          }
        }
      ]
    }
  ],
  "required": [
    "id",
    "type",
    "interventionType",
    "processNumber",
    "procedureType",
    "urbanOperationType",
    "status",
    "address",
    "location",
    "dateCreated",
    "dateModified"
  ]
}