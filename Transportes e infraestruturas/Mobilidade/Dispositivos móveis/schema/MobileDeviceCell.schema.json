{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$schemaVersion": "0.1.0",
  "modelTags": "CNMD",
  "$id": "https://example.org/schemas/MobileDeviceCell.schema.json",
  "title": "CNMD - MobileDeviceCell schema",
  "description": "A geographic cell used to represent mobile-device movement data.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/GSMA-Commons"
    },
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/Location-Commons"
    },
    {
      "properties": {
        "address": {
          "type": "object",
          "properties": {
            "addressLocality": {
              "type": "string",
              "minLength": 1,
              "description": "The locality, which must correspond to the municipality"
            },
            "addressRegion": {
              "type": "string",
              "enum": [
                "Norte",
                "Centro",
                "Oeste e Vale do Tejo",
                "Grande Lisboa",
                "Península de Setúbal",
                "Alentejo",
                "Algarve",
                "Região Autónoma dos Açores",
                "Região Autónoma da Madeira"
              ],
              "description": "The NUTS 2 region in which the locality is located"
            },
            "district": {
              "type": "string",
              "enum": [
                "Açores",
                "Aveiro",
                "Beja",
                "Braga",
                "Bragança",
                "Castelo Branco",
                "Coimbra",
                "Évora",
                "Faro",
                "Guarda",
                "Madeira",
                "Leiria",
                "Lisboa",
                "Portalegre",
                "Porto",
                "Santarém",
                "Setúbal",
                "Viana do Castelo",
                "Vila Real",
                "Viseu"
              ],
              "description": "The administrative district in which the locality is located"
            }
          },
          "required": [
            "addressLocality",
            "addressRegion",
            "district"
          ]
        },
        "type": {
          "type": "string",
          "const": "MobileDeviceCell",
          "description": "Property. NGSI entity type. It must be MobileDeviceCell."
        },
        "boundingBox": {
          "type": "object",
          "description": "GeoProperty. GeoJSON polygon representing the area of the cell.",
          "properties": {
            "type": {
              "const": "Polygon"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "required": [
            "type",
            "coordinates"
          ]
        },
        "cellRow": {
          "type": "integer",
          "description": "Property. Row number in a grid. Required with cellColumn when cellId is not used."
        },
        "cellColumn": {
          "type": "integer",
          "description": "Property. Column number in a grid. Required with cellRow when cellId is not used."
        },
        "cellId": {
          "type": "string",
          "minLength": 1,
          "description": "Property. Cell identifier. Required when cellRow and cellColumn are not used together."
        },
        "startDate": {
          "type": "string",
          "format": "date-time",
          "description": "Property. Start of the period during which the model data is valid, in ISO 8601 format."
        },
        "endDate": {
          "type": "string",
          "format": "date-time",
          "description": "Property. End of the period during which the model data is valid, in ISO 8601 format."
        }
      },
      "anyOf": [
        {
          "required": [
            "cellId"
          ]
        },
        {
          "required": [
            "cellRow",
            "cellColumn"
          ]
        }
      ]
    }
  ],
  "required": [
    "id",
    "type",
    "boundingBox",
    "startDate",
    "location",
    "dataProvider",
    "address"
  ]
}
