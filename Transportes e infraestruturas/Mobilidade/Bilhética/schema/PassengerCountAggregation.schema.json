{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$schemaVersion": "0.0.1",
  "modelTags": "CNMD",
  "$id": "https://example.org/schemas/PassengerCountAggregation/schema.json",
  "title": "Passenger Count Aggregation schema",
  "description": "Aggregated passenger counts for a public transport operator over a specified time period.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/GSMA-Commons"
    },
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/Location-Commons"
    },
    {
      "properties": {
        "address": {
          "type": "object",
          "properties": {
            "addressLocality": {
              "type": "string",
              "minLength": 1,
              "description": "The locality, which must correspond to the municipality"
            },
            "addressRegion": {
              "type": "string",
              "enum": [
                "Norte",
                "Centro",
                "Oeste e Vale do Tejo",
                "Grande Lisboa",
                "Península de Setúbal",
                "Alentejo",
                "Algarve",
                "Região Autónoma dos Açores",
                "Região Autónoma da Madeira"
              ],
              "description": "The NUTS 2 region in which the locality is located"
            },
            "addressSubRegion": {
              "type": "string",
              "enum": [
                "Alto Minho",
                "Cávado",
                "Ave",
                "Área Metropolitana do Porto",
                "Alto Tâmega e Barroso",
                "Tâmega e Sousa",
                "Douro",
                "Terras de Trás-os-Montes",
                "Região de Aveiro",
                "Região de Coimbra",
                "Região de Leiria",
                "Viseu Dão Lafões",
                "Beira Baixa",
                "Beiras e Serra da Estrela",
                "Oeste",
                "Médio Tejo",
                "Lezíria do Tejo",
                "Grande Lisboa",
                "Península de Setúbal",
                "Alentejo Litoral",
                "Baixo Alentejo",
                "Alto Alentejo",
                "Alentejo Central",
                "Algarve",
                "Região Autónoma dos Açores",
                "Região Autónoma da Madeira"
              ],
              "description": "Property. NUTS 3 sub region in which the locality is located."
            },
            "district": {
              "type": "string",
              "enum": [
                "Açores",
                "Aveiro",
                "Beja",
                "Braga",
                "Bragança",
                "Castelo Branco",
                "Coimbra",
                "Évora",
                "Faro",
                "Guarda",
                "Madeira",
                "Leiria",
                "Lisboa",
                "Portalegre",
                "Porto",
                "Santarém",
                "Setúbal",
                "Viana do Castelo",
                "Vila Real",
                "Viseu"
              ],
              "description": "The administrative district in which the locality is located"
            }
          },
          "required": [
            "addressLocality",
            "addressRegion",
            "district"
          ]
        },
        "type": {
          "type": "string",
          "const": "PassengerCountAggregation",
          "description": "Property. NGSI entity type. It has to be PassengerCountAggregation."
        },
        "operator": {
          "type": "string",
          "format": "uri",
          "description": "Relationship. Organization representing the public transport operator to which the aggregation refers."
        },
        "measurementValue": {
          "type": "integer",
          "description": "Property. Aggregated count observed during the specified period."
        },
        "countType": {
          "type": "string",
          "enum": [
            "boarding",
            "alighting",
            "tripValidation"
          ],
          "description": "Property. Passenger count represented by measurementValue."
        },
        "aggregationPeriod": {
          "type": "string",
          "enum": [
            "hour",
            "day",
            "week",
            "month",
            "year"
          ],
          "description": "Property. Temporal granularity of the aggregation."
        },
        "startDate": {
          "type": "string",
          "format": "date-time",
          "description": "Property. Start date and time of the interval covered by the aggregation."
        },
        "endDate": {
          "type": "string",
          "format": "date-time",
          "description": "Property. End date and time of the interval covered by the aggregation."
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Property. Date and time when the aggregation was generated in the source system."
        }
      }
    }
  ],
  "required": [
    "id",
    "type",
    "startDate",
    "endDate",
    "operator",
    "measurementValue",
    "countType",
    "aggregationPeriod"
  ]
}
