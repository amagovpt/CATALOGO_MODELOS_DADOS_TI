{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$schemaVersion": "0.3.1",
  "modelTags": "CNMD",
  "$id": "https://example.org/schemas/CycleNetwork.schema.json",
  "title": "CNMD - CycleNetwork schema",
  "description": "A network of cycle lanes, aligned with FIWARE Smart Data Models and INSPIRE.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/GSMA-Commons"
    },
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/Location-Commons"
    },
    {
      "properties": {
        "address": {
          "type": "object",
          "description": "Property. Address associated with the building.",
          "properties": {
            "addressCountry": {
              "type": "string",
              "description": "Property. Country in which the building is located."
            },
            "addressLocality": {
              "type": "string",
              "minLength": 1,
              "description": "Property. Locality, which must correspond to the municipality."
            },
            "addressRegion": {
              "type": "string",
              "enum": [
                "Norte",
                "Centro",
                "Oeste e Vale do Tejo",
                "Grande Lisboa",
                "Península de Setúbal",
                "Alentejo",
                "Algarve",
                "Região Autónoma dos Açores",
                "Região Autónoma da Madeira"
              ],
              "description": "Property. NUTS 2 region in which the locality is located."
            },
            "district": {
              "type": "string",
              "enum": [
                "Açores",
                "Aveiro",
                "Beja",
                "Braga",
                "Bragança",
                "Castelo Branco",
                "Coimbra",
                "Évora",
                "Faro",
                "Guarda",
                "Madeira",
                "Leiria",
                "Lisboa",
                "Portalegre",
                "Porto",
                "Santarém",
                "Setúbal",
                "Viana do Castelo",
                "Vila Real",
                "Viseu"
              ],
              "description": "Property. Administrative district in which the locality is located."
            },
            "postalCode": {
              "type": "string",
              "description": "Property. Postal code of the address."
            },
            "streetAddress": {
              "type": "string",
              "description": "Property. Street address of the building."
            },
            "streetNr": {
              "type": "string",
              "description": "Property. Street number of the building."
            }
          },
          "required": [
            "addressLocality",
            "addressRegion",
            "district"
          ]
        },
        "type": {
          "type": "string",
          "const": "CycleNetwork",
          "description": "Property. NGSI entity type. It must be CycleNetwork."
        },
        "beginLifespanVersion": {
          "type": "string",
          "format": "date-time",
          "description": "Property. Beginning of the real-world version. Model:'https://schema.org/DateTime'."
        },
        "boundingBox": {
          "$ref": "#/$defs/geoJsonGeometry",
          "description": "GeoProperty. GeoJSON geometry delimiting the cycle network."
        },
        "connectedNetworks": {
          "type": "array",
          "items": {
            "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/EntityIdentifierType"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Relationship. Cycle networks directly connected to this network."
        },
        "datasetResponsibleParty": {
          "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/EntityIdentifierType",
          "description": "Relationship. Party responsible for curating the dataset."
        },
        "endLifespanVersion": {
          "type": "string",
          "format": "date-time",
          "description": "Property. End of the real-world version. Model:'https://schema.org/DateTime'."
        },
        "hasParts": {
          "type": "array",
          "items": {
            "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/EntityIdentifierType"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Relationship. Elements that constitute the cycle network."
        },
        "lastFullInspection": {
          "type": "string",
          "format": "date-time",
          "description": "Property. Date of the last full inspection. Model:'https://schema.org/DateTime'."
        },
        "license": {
          "type": "string",
          "format": "uri",
          "description": "Property. License associated with the data. Model:'https://schema.org/URL'."
        },
        "maintenanceAuthority": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "contactPoint": {
              "type": "string",
              "minLength": 1
            },
            "website": {
              "type": "string",
              "format": "uri"
            }
          },
          "description": "Property. Authority responsible for maintaining the cycle network."
        },
        "nationalId": {
          "type": "string",
          "minLength": 1,
          "description": "Property. Identifier compatible with INSPIRE."
        },
        "networkStatus": {
          "type": "object",
          "properties": {
            "overallCondition": {
              "type": "string",
              "enum": [
                "excellent",
                "good",
                "fair",
                "poor",
                "critical"
              ]
            },
            "criticalPoints": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "overallCondition",
            "criticalPoints"
          ],
          "description": "Property. State of conservation of the cycle network."
        },
        "networkType": {
          "type": "string",
          "const": "road",
          "description": "Property. INSPIRE network type. It must be road."
        },
        "totalLength": {
          "type": "number",
          "minimum": 0,
          "description": "Property. Total length of the cycle network, normally in kilometres. Units:'KMT'. Model:'https://schema.org/Number'."
        },
        "updateFrequency": {
          "type": "string",
          "minLength": 1,
          "description": "Property. Frequency with which the data is updated. Model:'https://schema.org/Text'."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Property. Version of the data model. Model:'https://schema.org/Text'."
        }
      }
    }
  ],
  "$defs": {
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "lineStringCoordinates": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "polygonCoordinates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 4,
        "items": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "geoJsonGeometry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "Point" },
            "coordinates": { "$ref": "#/$defs/position" }
          },
          "required": ["type", "coordinates"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "LineString" },
            "coordinates": { "$ref": "#/$defs/lineStringCoordinates" }
          },
          "required": ["type", "coordinates"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "Polygon" },
            "coordinates": { "$ref": "#/$defs/polygonCoordinates" }
          },
          "required": ["type", "coordinates"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "MultiPoint" },
            "coordinates": {
              "type": "array",
              "items": { "$ref": "#/$defs/position" }
            }
          },
          "required": ["type", "coordinates"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "MultiLineString" },
            "coordinates": {
              "type": "array",
              "items": { "$ref": "#/$defs/lineStringCoordinates" }
            }
          },
          "required": ["type", "coordinates"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "MultiPolygon" },
            "coordinates": {
              "type": "array",
              "items": { "$ref": "#/$defs/polygonCoordinates" }
            }
          },
          "required": ["type", "coordinates"]
        }
      ]
    }
  },
  "required": [
    "id",
    "type",
    "name",
    "address",
    "boundingBox",
    "beginLifespanVersion",
    "owner",
    "totalLength"
  ]
}
