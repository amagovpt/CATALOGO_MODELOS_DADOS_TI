{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$schemaVersion": "0.0.1",
  "modelTags": "CNMD",
  "$id": "https://example.org/schemas/WaterDistributionNetwork.schema.json",
  "title": "CNMD - WaterDistributionNetwork schema",
  "description": "A drinking water distribution network, aligned with FIWARE Smart Data Models and INSPIRE.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/GSMA-Commons"
    },
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/Location-Commons"
    },
    {
      "properties": {
        "address": {
          "type": "object",
          "properties": {
            "addressLocality": {
              "type": "string",
              "minLength": 1,
              "description": "The locality, which must correspond to the municipality"
            },
            "addressRegion": {
              "type": "string",
              "enum": [
                "Norte",
                "Centro",
                "Oeste e Vale do Tejo",
                "Grande Lisboa",
                "Península de Setúbal",
                "Alentejo",
                "Algarve",
                "Região Autónoma dos Açores",
                "Região Autónoma da Madeira"
              ],
              "description": "The NUTS 2 region in which the locality is located"
            },
            "district": {
              "type": "string",
              "enum": [
                "Açores",
                "Aveiro",
                "Beja",
                "Braga",
                "Bragança",
                "Castelo Branco",
                "Coimbra",
                "Évora",
                "Faro",
                "Guarda",
                "Madeira",
                "Leiria",
                "Lisboa",
                "Portalegre",
                "Porto",
                "Santarém",
                "Setúbal",
                "Viana do Castelo",
                "Vila Real",
                "Viseu"
              ],
              "description": "The administrative district in which the locality is located"
            }
          }
        },
        "type": {
          "type": "string",
          "const": "WaterDistributionNetwork",
          "description": "Property. NGSI entity type. It must be WaterDistributionNetwork."
        },
        "beginLifespanVersion": {
          "type": "string",
          "format": "date-time",
          "description": "Property. Start of the real-world version of the entity. Model:'https://schema.org/DateTime'."
        },
        "endLifespanVersion": {
          "type": "string",
          "format": "date-time",
          "description": "Property. End of the real-world version of the entity. Model:'https://schema.org/DateTime'."
        },
        "boundingBox": {
          "$ref": "https://geojson.org/schema/Polygon.json",
          "description": "GeoProperty. GeoJSON Polygon delimiting the geographic area covered by the network."
        },
        "concessionaire": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[\\w\\-\\.\\{\\}\\$\\+\\*\\[\\]`|~^@!,:\\\\]+$",
              "description": "Property. Identifier format of any NGSI entity"
            },
            {
              "type": "string",
              "format": "uri",
              "description": "Property. Identifier format of any NGSI entity"
            }
          ],
          "description": "Relationship. Concessionaire of the network."
        },
        "connectedTo": {
          "type": "array",
          "items": {
            "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/EntityIdentifierType"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Relationship. Connected networks."
        },
        "criticalInfrastructure": {
          "type": "boolean",
          "description": "Property. Specifies whether the network is critical infrastructure. Model:'https://schema.org/Boolean'."
        },
        "datasetResponsibleParty": {
          "type": "string",
          "minLength": 1,
          "description": "Property. Party responsible for the dataset. Model:'https://schema.org/Text'."
        },
        "image": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "uniqueItems": true,
          "description": "Property. Images of the network. Model:'https://schema.org/URL'."
        },
        "lastInspectionDate": {
          "type": "string",
          "format": "date-time",
          "description": "Property. Date of the last inspection. Model:'https://schema.org/DateTime'."
        },
        "license": {
          "type": "string",
          "format": "uri",
          "description": "Property. License associated with the data. Model:'https://schema.org/URL'."
        },
        "maintainer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[\\w\\-\\.\\{\\}\\$\\+\\*\\[\\]`|~^@!,:\\\\]+$",
              "description": "Property. Identifier format of any NGSI entity"
            },
            {
              "type": "string",
              "format": "uri",
              "description": "Property. Identifier format of any NGSI entity"
            }
          ],
          "description": "Relationship. Party responsible for the maintenance of the network."
        },
        "maintenanceSchedule": {
          "type": "string",
          "enum": [
            "annual",
            "biannual",
            "quarterly",
            "monthly"
          ],
          "description": "Property. Frequency of maintenance. Model:'https://schema.org/Text'."
        },
        "networkType": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "potableWater",
              "irrigation",
              "industrialWater",
              "fireProtection",
              "stormwater"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Property. Type of water distribution network. Model:'https://schema.org/Text'."
        },
        "quality": {
          "type": "number",
          "minimum": 1,
          "maximum": 5,
          "description": "Property. Observed quality of the network component, where 5 is excellent. Model:'https://schema.org/Number'."
        },
        "refSubNetworks": {
          "type": "array",
          "items": {
            "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/EntityIdentifierType"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Relationship. Sub-networks that compose the main network."
        },
        "serviceCategory": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "residential",
              "commercial",
              "industrial",
              "agricultural",
              "municipal"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Property. Category of service provided by the network. Model:'https://schema.org/Text'."
        },
        "status": {
          "type": "string",
          "enum": [
            "operational",
            "planned",
            "underConstruction",
            "underMaintenance",
            "outOfService",
            "abandoned"
          ],
          "description": "Property. Operational status of the network. Model:'https://schema.org/Text'."
        },
        "suppliesTo": {
          "type": "array",
          "items": {
            "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/EntityIdentifierType"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Relationship. Entities supplied by the network."
        },
        "updateFrequency": {
          "type": "string",
          "minLength": 1,
          "description": "Property. Frequency at which the data is updated. Model:'https://schema.org/Text'."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Property. Version of the data model. Model:'https://schema.org/Text'."
        }
      }
    }
  ],
  "required": [
    "id",
    "name",
    "type",
    "boundingBox",
    "networkType",
    "beginLifespanVersion",
    "areaServed",
    "owner",
    "status"
  ]
}
