{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$schemaVersion": "0.0.1",
  "modelTags": "CNMD",
  "$id": "https://smart-data-models.github.io/dataModel.WaterDistributionManagementEPANET/Pipe/schema.json",
  "title": "Smart Data Models - Pipe schema",
  "description": "A pipe for a water distribution network",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/GSMA-Commons"
    },
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/Location-Commons"
    },
    {
      "properties": {
        "type": {
          "type": "string",
          "const": "Pipe",
          "description": "Property. NGSI Entity Type: It has to be Pipe"
        },
        "address": {
          "type": "object",
          "description": "Property. Address associated with the pipe. Model:'https://schema.org/address'",
          "properties": {
            "addressCountry": {
              "type": "string",
              "description": "Property. Country in which the pipe is located. Model:'https://schema.org/addressCountry'"
            },
            "addressLocality": {
              "type": "string",
              "minLength": 1,
              "description": "Property. Locality, which must correspond to the municipality. Model:'https://schema.org/addressLocality'"
            },
            "addressRegion": {
              "type": "string",
              "enum": [
                "Norte",
                "Centro",
                "Oeste e Vale do Tejo",
                "Grande Lisboa",
                "Península de Setúbal",
                "Alentejo",
                "Algarve",
                "Região Autónoma dos Açores",
                "Região Autónoma da Madeira"
              ],
              "description": "Property. NUTS 2 region in which the locality is located. Model:'https://schema.org/addressRegion'"
            },
            "district": {
              "type": "string",
              "enum": [
                "Açores",
                "Aveiro",
                "Beja",
                "Braga",
                "Bragança",
                "Castelo Branco",
                "Coimbra",
                "Évora",
                "Faro",
                "Guarda",
                "Madeira",
                "Leiria",
                "Lisboa",
                "Portalegre",
                "Porto",
                "Santarém",
                "Setúbal",
                "Viana do Castelo",
                "Vila Real",
                "Viseu"
              ],
              "description": "Property. Administrative district in which the locality is located"
            },
            "postalCode": {
              "type": "string",
              "description": "Property. Postal code. Model:'https://schema.org/postalCode'"
            },
            "streetAddress": {
              "type": "string",
              "description": "Property. Street address. Model:'https://schema.org/streetAddress'"
            },
            "streetNr": {
              "type": "string",
              "description": "Property. Street number. Model:'https://schema.org/Text'"
            }
          },
          "required": [
            "addressLocality",
            "addressRegion",
            "district"
          ]
        },
        "backfillMaterial": {
          "type": "string",
          "enum": ["nativeSoil", "granular", "flowableFill"],
          "description": "Property. Backfill material. Model:'https://schema.org/Text'"
        },
        "beddingMaterial": {
          "type": "string",
          "enum": ["gravel", "sand", "concrete", "crushedStone"],
          "description": "Property. Bedding material. Model:'https://schema.org/Text'"
        },
        "connectedTo": {
          "type": "array",
          "items": {
            "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/EntityIdentifierType"
          },
          "uniqueItems": true,
          "description": "Relationship. Pipes connected to this pipe. Model:'https://schema.org/Text'"
        },
        "constructionMethod": {
          "type": "string",
          "enum": ["openExcavation", "trenchless", "microtunneling", "directionalDrilling"],
          "description": "Property. Pipe construction method. Model:'https://schema.org/Text'"
        },
        "criticalInfrastructure": {
          "type": "boolean",
          "description": "Property. Whether the pipe is critical infrastructure. Model:'https://schema.org/Boolean'"
        },
        "crossSectionShape": {
          "type": "string",
          "enum": ["circular", "rectangular", "other"],
          "description": "Property. Pipe cross-section shape. Model:'https://schema.org/Text'"
        },
        "currentFlow": {
          "type": "number",
          "description": "Property. Current flow. Units:'MQS'. Model:'https://schema.org/Number'"
        },
        "datasetResponsibleParty": {
          "type": "string",
          "description": "Property. Party responsible for the dataset. Model:'https://schema.org/Text'"
        },
        "designCapacity": {
          "type": "number",
          "description": "Property. Designed flow capacity. Units:'MQS'. Model:'https://schema.org/Number'"
        },
        "diameter": {
          "type": "number",
          "minimum": 0,
          "description": "Property. Pipe diameter. Units:'MMT'. Model:'https://schema.org/Number'"
        },
        "dimension": {
          "$ref": "#/$defs/dimensions",
          "description": "Property. Cross-section dimensions. Units:'MMT'. Model:'https://schema.org/Number'"
        },
        "downstreamNetwork": {
          "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/EntityIdentifierType",
          "description": "Relationship. Connected downstream network. Model:'https://schema.org/Text'"
        },
        "elevation": {
          "$ref": "#/$defs/startEndNumber",
          "description": "Property. Start and end elevation. Units:'MTR'. Model:'https://schema.org/Number'"
        },
        "endPoint": {
          "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/EntityIdentifierType",
          "description": "Relationship. Pipe end point. Model:'https://schema.org/Text'"
        },
        "expectedLifespan": {
          "type": "number",
          "minimum": 0,
          "description": "Property. Expected lifespan. Units:'ANN'. Model:'https://schema.org/Number'"
        },
        "externalCoating": {
          "type": "string",
          "enum": ["none", "epoxy", "bitumen", "polyethylene", "zinc"],
          "description": "Property. External coating. Model:'https://schema.org/Text'"
        },
        "failureProbability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Property. Annual failure probability. Units:'C62'. Model:'https://schema.org/Number'"
        },
        "floodZone": {
          "type": "boolean",
          "description": "Property. Whether the pipe is in a flood zone. Model:'https://schema.org/Boolean'"
        },
        "groundwaterLevel": {
          "type": "number",
          "description": "Property. Groundwater level around the pipe. Units:'MTR'. Model:'https://schema.org/Number'"
        },
        "image": {
          "type": "array",
          "items": {"type": "string", "format": "uri"},
          "uniqueItems": true,
          "description": "Property. Pipe images. Model:'https://schema.org/URL'"
        },
        "installationDate": {
          "type": "string",
          "format": "date-time",
          "description": "Property. Pipe installation date. Model:'https://schema.org/DateTime'"
        },
        "installationDepth": {
          "type": "number",
          "minimum": 0,
          "description": "Property. Installation depth. Units:'MTR'. Model:'https://schema.org/Number'"
        },
        "internalLining": {
          "type": "string",
          "enum": ["none", "CIPP", "epoxy", "cement", "polyurethane"],
          "description": "Property. Internal lining. Model:'https://schema.org/Text'"
        },
        "jointType": {
          "type": "string",
          "enum": ["spigot", "flanged", "welded", "mechanical", "glued"],
          "description": "Property. Pipe joint type. Model:'https://schema.org/Text'"
        },
        "lastCleaningDate": {
          "type": "string",
          "format": "date-time",
          "description": "Property. Date when the pipe was last cleaned. Model:'https://schema.org/DateTime'"
        },
        "lastInspectionDate": {
          "type": "string",
          "format": "date-time",
          "description": "Property. Date when the pipe was last inspected. Model:'https://schema.org/DateTime'"
        },
        "length": {
          "type": "number",
          "minimum": 0,
          "description": "Property. Total pipe length. Units:'MTR'. Model:'https://schema.org/Number'"
        },
        "license": {
          "type": "string",
          "format": "uri",
          "description": "Property. Data license URL. Model:'https://schema.org/URL'"
        },
        "maintainer": {
          "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/EntityIdentifierType",
          "description": "Relationship. Party responsible for maintaining the pipe. Model:'https://schema.org/Text'"
        },
        "maintenanceSchedule": {
          "type": "string",
          "enum": ["annual", "biannual", "quarterly", "monthly"],
          "description": "Property. Maintenance frequency. Model:'https://schema.org/Text'"
        },
        "material": {
          "type": "string",
          "enum": ["PVC", "HDPE", "castIron", "ductileIron", "steel", "concrete", "asbestoCement", "copper", "lead"],
          "description": "Property. Pipe material. Model:'https://schema.org/Text'"
        },
        "materialClass": {
          "type": "string",
          "description": "Property. Material classification. Model:'https://schema.org/Text'"
        },
        "maxAllowablePressure": {
          "type": "number",
          "minimum": 0,
          "description": "Property. Maximum allowable pressure. Units:'BAR'. Model:'https://schema.org/Number'"
        },
        "operatingPressure": {
          "type": "number",
          "minimum": 0,
          "description": "Property. Operating pressure. Units:'BAR'. Model:'https://schema.org/Number'"
        },
        "pressureClass": {
          "type": "string",
          "enum": ["PN6", "PN10", "PN12.5", "PN16", "PN20"],
          "description": "Property. Pipe pressure class. Model:'https://schema.org/Text'"
        },
        "quality": {
          "type": "number",
          "minimum": 1,
          "maximum": 5,
          "description": "Property. Observed network component quality, from 1 to 5. Model:'https://schema.org/Number'"
        },
        "refNetwork": {
          "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/EntityIdentifierType",
          "description": "Relationship. Network to which the pipe belongs. Model:'https://schema.org/Text'"
        },
        "restrictedAccess": {
          "type": "boolean",
          "description": "Property. Whether access to the pipe is restricted. Model:'https://schema.org/Boolean'"
        },
        "seismicZone": {
          "type": "string",
          "enum": ["low", "moderate", "high"],
          "description": "Property. Seismic zone. Model:'https://schema.org/Text'"
        },
        "slope": {
          "type": "number",
          "description": "Property. Pipe slope. Units:'C62'. Model:'https://schema.org/Number'"
        },
        "soilCorrosivity": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "Property. Corrosivity of the surrounding soil. Model:'https://schema.org/Text'"
        },
        "startPoint": {
          "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/EntityIdentifierType",
          "description": "Relationship. Pipe start point. Model:'https://schema.org/Text'"
        },
        "status": {
          "type": "string",
          "enum": ["operational", "planned", "underConstruction", "underMaintenance", "outOfService", "abandoned"],
          "description": "Property. Operational status. Model:'https://schema.org/Text'"
        },
        "surroundingSoilType": {
          "type": "string",
          "enum": ["clay", "sand", "gravel", "rock", "silt", "peat"],
          "description": "Property. Type of surrounding soil. Model:'https://schema.org/Text'"
        },
        "updateFrequency": {
          "type": "string",
          "description": "Property. Frequency with which the data is updated. Model:'https://schema.org/Text'"
        },
        "upstreamNetwork": {
          "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/EntityIdentifierType",
          "description": "Relationship. Connected upstream network. Model:'https://schema.org/Text'"
        },
        "velocityRange": {
          "$ref": "#/$defs/minimumMaximumNumber",
          "description": "Property. Flow velocity range. Units:'MTS'. Model:'https://schema.org/Number'"
        },
        "version": {
          "type": "string",
          "description": "Property. Data model version. Model:'https://schema.org/Text'"
        },
        "verticalGeometry": {
          "$ref": "#/$defs/geoJsonLineString",
          "description": "Property. Vertical pipe geometry using 3D LineString coordinates. Model:'https://schema.org/GeoShape'"
        },
        "wallThickness": {
          "type": "number",
          "minimum": 0,
          "description": "Property. Pipe wall thickness. Units:'MMT'. Model:'https://schema.org/Number'"
        }
      }
    }
  ],
  "$defs": {
    "dimensions": {
      "type": "object",
      "properties": {
        "diameter": {"type": "number", "minimum": 0},
        "height": {"type": "number", "minimum": 0},
        "width": {"type": "number", "minimum": 0}
      },
      "oneOf": [
        {"required": ["diameter"]},
        {"required": ["height", "width"]}
      ]
    },
    "geoJsonLineString": {
      "type": "object",
      "properties": {
        "type": {"const": "LineString"},
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "number"}
          }
        }
      },
      "required": ["type", "coordinates"]
    },
    "minimumMaximumNumber": {
      "type": "object",
      "properties": {
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      },
      "required": ["minimum", "maximum"]
    },
    "startEndNumber": {
      "type": "object",
      "properties": {
        "start": {"type": "number"},
        "end": {"type": "number"}
      },
      "required": ["start", "end"]
    }
  },
  "required": [
    "id",
    "name",
    "type",
    "address",
    "location",
    "refNetwork",
    "diameter",
    "material",
    "materialClass",
    "pressureClass",
    "slope",
    "status"
  ]
}
